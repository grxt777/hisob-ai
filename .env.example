OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_PROVIDER=relace/fp4
# Instagram Graph API (токен владельца аккаунта) — аналитика каждого поста и охват
INSTAGRAM_ACCESS_TOKEN=
# SOCIAL_REFRESH_HOURS=6
# Интеграции ЭСФ (опционально; URL можно задать и в UI «Связи»)
# DIDOX_API_URL=https://api.didox.uz
# ONEC_API_URL=http://localhost/hisob/odata/standard.odata
# SOLIQ_API_URL=https://my.soliq.uz

# Telegram-бот и Mini App
TELEGRAM_BOT_TOKEN=
# Публичный https-адрес сервера (на Railway: https://<проект>.up.railway.app) — нужен для Mini App
PUBLIC_URL=
# 0 — не запускать бота в этом экземпляре (например, локально, если бот уже работает на Railway)
# BOT_POLLING=0
# Где хранить общую базу документов и историю соцсетей (на Railway — volume, например /data)
# DATA_DIR=/data
# Распознавание голоса в Mini App: по умолчанию через OPENROUTER_API_KEY (модели можно сменить)
# OPENROUTER_STT_MODELS=qwen/qwen3.8-omni-flash,google/gemini-2.5-flash
# или отдельный сервис (одно из двух)
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
